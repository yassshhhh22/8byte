{
  "name": "8byte-portfolio-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack portfolio monitoring dashboard",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace @8byte/client",
    "dev:server": "npm run dev --workspace @8byte/server",
